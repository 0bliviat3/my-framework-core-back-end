# ========================================
# Framework Backend 환경 변수 설정 예시
# ========================================
# 이 파일을 .env로 복사하여 사용하세요
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!

# ========================================
# 데이터베이스 설정 (MariaDB)
# ========================================
DB_ROOT_PASSWORD=very_secure_root_password_change_me_123
DB_NAME=framework
DB_USERNAME=framework_user
DB_PASSWORD=very_secure_user_password_change_me_456
DB_EXTERNAL_PORT=13306
DB_POOL_MAX=20
DB_POOL_MIN=5

# ========================================
# Redis 설정
# ========================================
REDIS_PASSWORD=redis_password_change_me_789
REDIS_EXTERNAL_PORT=16379
REDIS_DB=0

# ========================================
# 애플리케이션 설정
# ========================================
APP_EXTERNAL_PORT=8080

# JPA 설정
JPA_DDL_AUTO=validate  # 운영: validate, 개발: update
JPA_SHOW_SQL=false

# ========================================
# 보안 설정
# ========================================
# CORS 허용 Origin (프론트엔드 도메인, 콤마로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_MAX_AGE=3600

# ========================================
# 세션 및 쿠키 설정
# ========================================
# 쿠키 보안 설정
COOKIE_SECURE=false  # HTTPS 환경에서는 true, HTTP 개발환경에서는 false
COOKIE_SAME_SITE=Lax  # Strict(동일 사이트만), Lax(일부 크로스 사이트 허용), None(모든 크로스 사이트, Secure=true 필수)
COOKIE_DOMAIN=  # 비워두면 현재 도메인만, .yourdomain.com 형식으로 서브도메인 포함

# 세션 타임아웃
SESSION_TIMEOUT=30m
SESSION_COOKIE_MAX_AGE=1800  # 쿠키 유효기간 (초 단위, 30분 = 1800초)

# 세션 보안 검증
SESSION_VALIDATE_IP=false  # IP 주소 검증 활성화 (Docker/프록시 환경에서 문제 발생 가능)
SESSION_VALIDATE_UA=false  # User-Agent 검증 활성화
SESSION_TRUSTED_PROXIES=  # 신뢰할 수 있는 프록시 IP 주소 (쉼표로 구분, 예: 10.0.0.1,192.168.1.1)

# 세션 갱신 설정
SESSION_REFRESH_ENABLED=true  # 세션 자동 갱신 활성화
SESSION_REFRESH_THRESHOLD=0.5  # 세션 시간의 50% 남았을 때 자동 갱신

# 동시 세션 관리
SESSION_CONCURRENT_ENABLED=true  # 동시 세션 제한 활성화
SESSION_MAX_SESSIONS=3  # 사용자당 최대 동시 세션 수
SESSION_PREVENT_LOGIN=false  # false=가장 오래된 세션 종료, true=새 로그인 차단

# ========================================
# 로깅 설정
# ========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SQL_BIND=WARN

# ========================================
# 비밀번호 암호화 설정
# ========================================
PASSWORD_SALT_SIZE=16
PASSWORD_ITERATION=10000

# ========================================
# JVM 설정
# ========================================
JVM_MIN_HEAP=512m
JVM_MAX_HEAP=1024m

# ========================================
# 파일 업로드 설정
# ========================================
FILE_UPLOAD_DIR=/app/uploads/board
