# ========================================
# 배포 환경 설정 예시 (deploy/.env)
# ========================================
# 이 파일을 .env로 복사하여 사용하세요
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!

# ========================================
# Docker 이미지 설정
# ========================================
# Docker Hub 사용 예시: myusername/framework-backend:1.0.0
# Private Registry 사용 예시: registry.company.com/framework-backend:1.0.0
DOCKER_IMAGE=framework-backend:latest

# ========================================
# 데이터베이스 설정 (MariaDB)
# ========================================
DB_ROOT_PASSWORD=very_secure_root_password_change_me_123
DB_NAME=framework
DB_USERNAME=framework_user
DB_PASSWORD=very_secure_user_password_change_me_456
DB_EXTERNAL_PORT=13306
DB_POOL_MAX=20
DB_POOL_MIN=5

# ========================================
# Redis 설정
# ========================================
REDIS_PASSWORD=redis_password_change_me_789
REDIS_EXTERNAL_PORT=16379
REDIS_DB=0

# ========================================
# 애플리케이션 설정
# ========================================
APP_EXTERNAL_PORT=8080

# JPA 설정
JPA_DDL_AUTO=update  # 운영: validate, 개발: update 최초 배포는 update로 처리해야함
JPA_SHOW_SQL=false

# ========================================
# 보안 설정
# ========================================
# CORS 허용 Origin (프론트엔드 도메인, 콤마로 구분)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_MAX_AGE=3600

# 쿠키 보안 (HTTPS 사용 시 true)
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict  # strict, lax, none

# 세션 타임아웃
SESSION_TIMEOUT=30m

# ========================================
# 로깅 설정
# ========================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN

# ========================================
# 비밀번호 암호화 설정
# ========================================
PASSWORD_SALT_SIZE=16
PASSWORD_ITERATION=10000

# ========================================
# JVM 설정
# ========================================
JVM_MIN_HEAP=512m
JVM_MAX_HEAP=2048m
